# Kopie als ".env" anlegen und Werte anpassen (echte .env NICHT committen).
# In Portainer stattdessen als Stack-Environment-Variablen eintragen.

# Langer, zufälliger Wert – signiert die Login-Session. Pflicht.
APP_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen

# Zugangsdaten für /control. Bitte ändern!
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Maximale Upload-Größe pro Datei in MB.
MAX_UPLOAD_MB=25
