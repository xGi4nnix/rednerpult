# Kopie als ".env" anlegen und Werte anpassen (echte .env NICHT committen).
# In Portainer stattdessen als Stack-Environment-Variablen eintragen.

# Langer, zufälliger Wert – signiert die Login-Session. Pflicht.
APP_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen

# Zugangsdaten für /control. Bitte ändern!
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Maximale Upload-Größe pro Datei in MB.
MAX_UPLOAD_MB=25

# Feste Quellen in der Grafiken-Liste.
# NDI/RTMP sind im Browser nicht direkt dekodierbar. Hier eine browserfähige
# Zwischenquelle eintragen, z.B. MJPEG, MP4/WebM, WebRTC/HLS-Player-Seite oder
# eine lokale Preview-Seite eines NDI/RTMP-Gateways.
NDI_STREAM_URL=
RTMP_STREAM_URL=

# Optional: auto, video, image oder iframe.
# auto erkennt einfache Bild-/Video-URLs, sonst wird iframe benutzt.
NDI_STREAM_MODE=auto
RTMP_STREAM_MODE=auto
